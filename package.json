{
  "name": "cleanyourandroid-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CleanYourAndroid — Open-Source Android Customization Toolkit",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"packages/**/src/**/*.ts\" \"apps/**/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "clean": "pnpm -r exec rimraf dist",
    "cya": "pnpm --filter @cleanyourandroid/cli run dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

