    "@cleanyourandroid/customizer": "workspace:*",
    "@cleanyourandroid/themes": "workspace:*",
    "@cleanyourandroid/backup": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
