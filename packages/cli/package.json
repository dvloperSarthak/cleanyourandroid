{
  "name": "cleanyourandroid",
  "version": "1.0.3",
  "description": "CleanYourAndroid CLI — open-source Android customization and debloating toolkit",
  "homepage": "https://github.com/dvloperSarthak/cleanyourandroid#readme",
  "bugs": {
    "url": "https://github.com/dvloperSarthak/cleanyourandroid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvloperSarthak/cleanyourandroid.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "cleanyourandroid": "./bin/cya.js",
    "cya": "./bin/cya.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "node ./bin/cya.js"
  },
  "dependencies": {
    "@cleanyourandroid/shared": "workspace:*",
    "@cleanyourandroid/core": "workspace:*",
    "commander": "^13.1.0",
    "chalk": "^5.4.1",
    "inquirer": "^12.4.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.7.3"
  }
}
